{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "RPC requests per second",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (rate(moonlight_bridge_requests_started_total[1m]))", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "RPC failures per second",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (rate(moonlight_bridge_requests_failed_total[1m]))", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "stat",
      "title": "Transferred request bytes",
      "id": 3,
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (moonlight_bridge_request_bytes_total)", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Transferred response bytes",
      "id": 4,
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (moonlight_bridge_response_bytes_total)", "legendFormat": "{{job}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Java client latency p95",
      "id": 5,
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(moonlight_bridge_request_latency_seconds_bucket{job=\"moonlight-java\"}[1m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["moonlightbridge", "prometheus", "opentelemetry"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
